# API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
# The public domain / URL where this server is reachable (used for push notification click links)
# Local Wi-Fi: http://192.168.1.3:8000
# Tunnel: https://my-transcriptor-api.loca.lt
# Cloud (Render/VPS): https://my-app.onrender.com
BASE_URL=https://my-transcriptor-api.loca.lt


# Optional: Default LLM Model to use for script cleanup
GEMINI_MODEL=gemini-2.5-flash

# Optional: Push Notifications (ntfy.sh) - 100% Free, zero account needed!
# Choose any secret topic name (e.g. my_scripts_x8291)
NTFY_TOPIC=

